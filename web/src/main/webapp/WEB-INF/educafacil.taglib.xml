<?xml version="1.0" encoding="UTF-8"?>
<facelet-taglib
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
        https://jakarta.ee/xml/ns/jakartaee/web-facelettaglibrary_4_0.xsd"
    version="4.0">

    <namespace>http://mileniumtech.ec/educafacil</namespace>
    <short-name>ef</short-name>

    <!-- ──────────────────────────────────────────────
         Componente: Header Panel
         Encabezado de página estandarizado con icono,
         título, subtítulo y zona de acciones.
         ────────────────────────────────────────────── -->
    <tag>
        <tag-name>headerPanel</tag-name>
        <source>resources/componentes/headerPanel.xhtml</source>
    </tag>

    <!-- ──────────────────────────────────────────────
         Componente: Stats Card
         Tarjeta KPI reutilizable con icono, label,
         valor, tendencia y enlace de navegación.
         ────────────────────────────────────────────── -->
    <tag>
        <tag-name>statsCard</tag-name>
        <source>resources/componentes/statsCard.xhtml</source>
    </tag>

    <!-- ──────────────────────────────────────────────
         Componente: Empty State
         Estado vacío con icono, título, mensaje
         y botón de acción opcional.
         ────────────────────────────────────────────── -->
    <tag>
        <tag-name>emptyStatePanel</tag-name>
        <source>resources/componentes/emptyStatePanel.xhtml</source>
    </tag>

    <!-- ──────────────────────────────────────────────
         Componente: Search Bar
         Barra de búsqueda con campo de texto,
         botón de búsqueda y zona de acciones extra.
         ────────────────────────────────────────────── -->
    <tag>
        <tag-name>searchBarPanel</tag-name>
        <source>resources/componentes/searchBarPanel.xhtml</source>
    </tag>

    <!-- ──────────────────────────────────────────────
         Componente: Table Actions
         Botones de acción para tablas (ver, editar,
         eliminar) con iconos y tooltips.
         ────────────────────────────────────────────── -->
    <tag>
        <tag-name>tableActionsPanel</tag-name>
        <source>resources/componentes/tableActionsPanel.xhtml</source>
    </tag>

</facelet-taglib>
